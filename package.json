{
  "name": "shopify-import-tool",
  "version": "1.0.0",
  "description": "Full-featured web app to import WooCommerce stores or CSV files to Shopify with real-time progress tracking",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": [
    "shopify",
    "woocommerce",
    "import",
    "migration",
    "bulk-operations"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "ws": "^8.16.0",
    "@shopify/shopify-api": "^9.3.1",
    "@woocommerce/woocommerce-rest-api": "^1.0.1",
    "axios": "^1.6.7",
    "csv-parser": "^3.0.0",
    "papaparse": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "bull": "^4.12.2",
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "concurrently": "^8.2.2"
  }
}
